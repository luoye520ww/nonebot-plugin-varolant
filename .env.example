# ============================================================
# NoneBot2 基础配置（机器人宿主项目 .env 模板）
# 使用方法：把本文件内容合并进你 NoneBot2 项目的 .env，
# 按注释改好 SUPERUSERS 后 `nb run` 即可，插件零额外配置。
# ============================================================

# ---- 驱动与网络 ----
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080

# ---- 超级用户（改成你自己的 QQ 号，用于 /s 群开关等管理命令）----
SUPERUSERS=["123456789"]

# ---- 命令解析 ----
# “瓦”业务命令无需 / 前缀；群开关使用 /s 开启瓦、/s 关闭瓦、/s 瓦
COMMAND_START=["", "/"]
COMMAND_SEP=["."]

# ---- 日志 ----
LOG_LEVEL=INFO

# ---- OneBot V11 适配器 ----
# 按你的协议端（NapCat / Lagrange / go-cqhttp 等）配置连接方式。
# 默认反向 WebSocket：协议端连 ws://127.0.0.1:8080/onebot/v11/ws
# （OneBot V11 适配器无需额外 .env 配置项；正向 WS 请在协议端配置。）

# nonebot-plugin-varolant 无需额外环境变量，安装并加载后即可使用。
# 掌瓦 App 商店登录方式、监控时间、时区、通知机器人及登录回调均已内置合理默认值。
